CREATE TABLE Cliente 
( 
 cod_cliente INT PRIMARY KEY,  
 nome INT,  
 telefone INT,  
 status INT,  
 limite_credito INT,  
 cep INT,  
 rua INT,  
 sala INT,  
 cidade INT,  
 UF INT,  
 nro INT,  
); 

CREATE TABLE Pedido 
( 
 numero_pedido INT PRIMARY KEY,  
 idCliente INT,  
 data_elaboracao INT,  
); 

CREATE TABLE Produto 
( 
 cod_produto INT PRIMARY KEY,  
 idCategoria INT,  
 nome_produto INT,  
 preco INT,  
); 

CREATE TABLE Categoria 
( 
 nome_categoria INT PRIMARY KEY,  
); 

CREATE TABLE Contem 
( 
 cod_produto INT PRIMARY KEY,  
 numero_pedido INT PRIMARY KEY,  
 quantidade INT,  
); 

